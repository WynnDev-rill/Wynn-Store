---
import boundaries from '../data/provinces.json';
import Cite from './Cite.astro';
const project=([lng,lat]:number[])=>[(lng-108)*63+25,(5.1-lat)*63+15];
const poly=(c:number[][][])=>c.map(r=>r.map((p,i)=>`${i?'L':'M'}${project(p).map(v=>v.toFixed(1)).join(',')}`).join('')+'Z').join('');
const path=(g:any)=>g.type==='MultiPolygon'?g.coordinates.map(poly).join(''):poly(g.coordinates);
const names=[['Central Kalimantan','Kalimantan Tengah','tengah'],['West Kalimantan','Kalimantan Barat','barat'],['South Kalimantan','Kalimantan Selatan','selatan'],['East Kalimantan','Kalimantan Timur','timur'],['North Kalimantan','Kalimantan Utara','utara']];
---
<a class="text-link" href="/data/hotspot-2026.csv" download>Unduh cuplikan Oktober 2026 (CSV)</a><div class="current-map"><div><p class="small">Cuplikan SiPongi dalam rilis Kemenhut · high confidence</p><div class="current-date-options" role="group" aria-label="Tanggal cuplikan hotspot"><button data-snapshot="0" aria-pressed="false">22 Oktober 2026</button><button data-snapshot="1" aria-pressed="true">23 Oktober 2026</button></div><svg viewBox="0 0 760 650" aria-labelledby="current-map-title"><title id="current-map-title">Cuplikan jumlah hotspot per provinsi, 23 Oktober 2026 pukul 21.00 WIB</title>{boundaries.features.map(f=>{const n=names.find(n=>n[0]===f.properties.shapeName)!;return <path class="snapshot-province" data-snapshot-province={n[2]} d={path(f.geometry)} fill={['tengah','barat','selatan'].includes(n[2])?'#edb173':'#40584a'}><title>{n[1]}</title></path>})}<g fill="#142823" font-size="23" font-weight="600" text-anchor="middle"><text x="204" y="337">Barat</text><text x="375" y="441">Tengah</text><text x="486" y="523">Selatan</text><text fill="white" x="535" y="319">Timur*</text><text fill="white" x="578" y="119">Utara*</text></g></svg><p class="small muted-light">*Tidak dirinci dalam rilis ini. Warna menandai wilayah yang dibahas; bukan lokasi setiap titik api dan bukan luas terbakar.</p></div><div class="snapshot-detail"><h3>Wilayah yang perlu dibaca bersama waktunya.</h3><p class="small" id="snapshot-timestamp">23 Oktober 2026 · 21.00 WIB</p><div class="snapshot-values" aria-live="polite">{[['tengah','Kalimantan Tengah','785'],['barat','Kalimantan Barat','184'],['selatan','Kalimantan Selatan','30']].map(([id,name,v])=><div><span>{name}</span><strong data-current-value={id}>{v}</strong><span>hotspot high confidence</span></div>)}</div><p class="small">Satu kejadian bisa menghasilkan beberapa deteksi. Angka ini bukan jumlah kebakaran, hektare, atau kondisi saat ini. <span id="current-cite"><Cite id="current24"/></span></p><a class="text-link" id="snapshot-source" href="/sumber/#current24">Periksa rilis bertanggal</a></div></div>
<script>
const rows=[{date:'22 Oktober 2026 · 21.00 WIB',values:[874,39,99],source:'current23'},{date:'23 Oktober 2026 · 21.00 WIB',values:[785,184,30],source:'current24'}];
document.querySelectorAll<HTMLButtonElement>('[data-snapshot]').forEach(b=>b.addEventListener('click',()=>{const i=Number(b.dataset.snapshot),r=rows[i];document.querySelectorAll('[data-snapshot]').forEach(el=>el.setAttribute('aria-pressed',String(el===b)));['tengah','barat','selatan'].forEach((id,j)=>{const value=document.querySelector(`[data-current-value="${id}"]`);if(value)value.textContent=String(r.values[j]);});const t=document.querySelector('#snapshot-timestamp');if(t)t.textContent=r.date;document.querySelector('#snapshot-source')?.setAttribute('href',`/sumber/#${r.source}`);const cite=document.querySelector('#current-cite a');cite?.setAttribute('href',`/sumber/#${r.source}`);if(cite){cite.textContent=i===0?'[Kemenhut · 23 Oktober 2026]':'[Kemenhut · 24 Oktober 2026]';cite.setAttribute('aria-label',i===0?'Sumber Kemenhut 23 Oktober 2026':'Sumber Kemenhut 24 Oktober 2026');}document.querySelector('#current-map-title')!.textContent=`Jumlah hotspot per provinsi, ${r.date}`;}));
</script>
