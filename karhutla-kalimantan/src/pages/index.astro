---
import SiteLayout from '../components/SiteLayout.astro';
import Cite from '../components/Cite.astro';
import Icon from '../components/Icon.astro';
import CurrentMap from '../components/CurrentMap.astro';
import DataMap from '../components/DataMap.astro';
import SeasonJourney from '../components/SeasonJourney.astro';
import ForestWorld from '../components/ForestWorld.astro';
import Weather from '../components/Weather.astro';
import CinematicLandscape from '../components/CinematicLandscape.astro';
import {chronology,peatStages} from '../data/content';
const readings=[[198,38,52],[874,39,99],[785,184,30]];
---
<SiteLayout home>
<Weather/>
<main id="main">
<section class="hero hero-lab cinematic-hero" aria-labelledby="hero-title">
<CinematicLandscape/>
<div class="cinema-vignette" aria-hidden="true"></div>
<div class="hero-contours" aria-hidden="true"><svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice">{Array.from({length:16},(_,i)=><ellipse cx="1010" cy="485" rx={240+i*34} ry={130+i*28} transform={`rotate(-28 1010 485)`}/>)}</svg></div>
<div class="hero-top"><p>Dokumenter interaktif / 01<br/>Kalimantan, Indonesia</p><p class="hero-location">Januari—Oktober 2026<br/><span>Diperiksa 25 Oktober</span></p></div>
<div class="hero-title-wrap"><p class="hero-kicker">Sebuah perjalanan ke dalam bentang</p><h1 id="hero-title" aria-label="Kalimantan. Di balik asap."><span class="hero-word" aria-hidden="true">Kalimantan<span class="hero-period">.</span></span><span class="hero-second" aria-hidden="true"><span>Di balik</span> <em>asap.</em></span></h1></div>
<figure class="hero-observation" data-depth-image><picture><img src="/media/borneo-smoke-2023-thumb.webp" alt="Citra satelit Terra/MODIS: asap di atas Kalimantan bagian selatan, 2 Oktober 2023." width="720" height="480" loading="lazy" decoding="async"/></picture><figcaption><span>01 / Pengamatan dari langit</span><a href="/sumber/#nasa2023">NASA · citra arsip 2023 <Icon name="external" size={12}/></a></figcaption><span class="observation-cross" aria-hidden="true">+</span></figure>
<div class="hero-subrow"><p class="hero-subtitle">Satu musim api.<br/>Jejak yang belum usai.</p><a class="start-story" href="#ruang"><span>Masuk ke hutan</span><span class="round-arrow"><Icon name="down" size={25}/></span></a></div>
<div class="hero-footer"><span>01 / Bentang yang menyimpan jejak</span><span class="landscape-note">Bentang 3D ilustratif · bukan peta titik api</span><span>Gulir untuk menjelajah ↓</span></div>
</section>
<nav class="chapter-rail" aria-label="Lompati ke bab"><span class="rail-label">Ikuti jejaknya</span><div>{[['ruang','Ruang'],['musim','Jejak 2026'],['cerita','Sinyal'],['gambut','Gambut'],['peta','Peta'],['dampak','Dampak'],['pulih','Pulih'],['wynn','Wynn']].map(([id,t],i)=><a href={`#${id}`} data-chapter-link={id}><span>{String(i+1).padStart(2,'0')}</span>{t}</a>)}</div></nav>
<ForestWorld/>
<SeasonJourney/>
<section id="cerita" class="section signal-section" aria-labelledby="intro-title">
<div class="section-meta"><span>01 / Membaca sinyal</span><span>Dari deteksi menuju penanganan</span></div>
<div class="signal-heading"><h2 id="intro-title" data-reveal>Terlihat dari langit.<br/><span class="serif-word">Diperiksa di tanah.</span></h2><p>Dari awal tahun hingga Oktober, api muncul di lokasi dan waktu yang berbeda. Deteksi satelit mengarahkan pemeriksaan; petugas memastikan keadaan di tanah. <Cite id="current24"/></p></div>
<div class="signal-flow" aria-label="Dari deteksi menuju penanganan">
<article data-reveal><div class="signal-symbol signal-detect" aria-hidden="true"><i></i><b></b><span></span></div><span class="flow-index">01 / Satelit</span><h3>Deteksi</h3><p>Anomali suhu terdeteksi sebagai hotspot. Satu kebakaran dapat menghasilkan beberapa deteksi.</p></article>
<span class="flow-connector" aria-hidden="true">↗</span>
<article data-reveal><div class="signal-symbol signal-check" aria-hidden="true"><i></i><b>+</b></div><span class="flow-index">02 / Lapangan</span><h3>Verifikasi</h3><p>Patroli dan groundcheck memeriksa apakah ada api, bara, dan lokasi yang perlu ditangani.</p></article>
<span class="flow-connector" aria-hidden="true">↗</span>
<article data-reveal><div class="signal-symbol signal-water" aria-hidden="true"><i></i><b></b><span></span></div><span class="flow-index">03 / Respons</span><h3>Tangani</h3><p>Pemadaman, pembasahan, penyisiran bara dan pendinginan mengikuti kondisi nyata.</p></article>
</div><p class="flow-footnote">Hotspot ≠ jumlah kebakaran ≠ hektare terbakar. <Cite id="current23"/></p>
</section>
<details class="daily-detail section"><summary>Di dalam laporan: deteksi 21–23 Oktober</summary><section id="riwayat" class="section history-section" aria-labelledby="history-title"><div class="section-meta"><span>02 / Tiga hari dalam laporan</span><span>21–23 Oktober 2026 · 21.00 WIB</span></div><div class="section-heading-row"><h2 id="history-title" data-reveal>Angka bergerak.<br/><span class="serif-word">Respons berlanjut.</span></h2><p class="section-deck">Deteksi hotspot high confidence dalam tiga cuplikan SiPongi. Angka antarhari tidak dijumlahkan. <Cite id="current22"/> <Cite id="current23"/> <Cite id="current24"/></p></div>
<figure class="chronology-chart" data-reveal><svg viewBox="0 0 1120 330" role="img" aria-labelledby="trend-title trend-desc"><title id="trend-title">Hotspot tiga provinsi pada 21, 22 dan 23 Oktober 2026</title><desc id="trend-desc">Kalimantan Tengah: 198, 874, 785. Kalimantan Barat: 38, 39, 184. Kalimantan Selatan: 52, 99, 30. Angka adalah deteksi, bukan luas kebakaran.</desc><g class="trend-grid"><path d="M60 40H1060M60 160H1060M60 280H1060"/><text x="0" y="45">900</text><text x="0" y="165">450</text><text x="0" y="285">0</text></g><g class="trend-line"><path d="M70 227L500 47L930 71" stroke="#aa3e20"/><path d="M70 270L500 270L930 231" stroke="#2d666c"/><path d="M70 266L500 254L930 272" stroke="#53625b" stroke-dasharray="5 7"/></g><g class="trend-nodes">{readings.map((v,i)=>v.map((n,j)=><circle cx={70+i*430} cy={280-n/900*240} r="5" fill={['#aa3e20','#2d666c','#53625b'][j]}/>))}</g><g class="trend-labels"><text x="954" y="78">785</text><text x="954" y="235">184</text><text x="954" y="283">30</text></g><g class="trend-dates"><text x="70" y="320">21 Oktober</text><text x="500" y="320">22 Oktober</text><text x="930" y="320">23 Oktober</text></g></svg><figcaption><span><i class="key-tengah"></i>Kalimantan Tengah</span><span><i class="key-barat"></i>Kalimantan Barat</span><span><i class="key-selatan"></i>Kalimantan Selatan</span></figcaption></figure>
<div class="timeline-tabs" role="tablist" aria-label="Pilih tanggal cuplikan">{chronology.map((c,i)=><button id={`year-tab-${i}`} role="tab" aria-selected={i===2} aria-controls={`year-panel-${i}`} tabindex={i===2?0:-1} data-history-tab={i}><span class="timeline-dot"></span>{c.year} 2026</button>)}</div>
<div class="timeline-panels">{chronology.map((c,i)=><article class="history-panel" id={`year-panel-${i}`} role="tabpanel" aria-labelledby={`year-tab-${i}`} hidden={i!==2}><div class="history-reading">{readings[i].map((v,j)=><div><span>{['Tengah','Barat','Selatan'][j]}</span><strong>{v}</strong></div>)}</div><div class="history-story"><p class="place-label">{c.place}</p><h3>{c.title}</h3><p>{c.text} <Cite id={c.source}/></p></div></article>)}</div>
<noscript><div class="noscript-history">{chronology.filter((_,i)=>i!==2).map(c=><article><h3>{c.year} · {c.title}</h3><p>{c.text} <Cite id={c.source}/></p></article>)}</div></noscript>
</section>
</details><section id="gambut" class="peat-section" aria-labelledby="peat-title"><div class="section section-peat-header"><div class="section-meta"><span>03 / Di bawah permukaan</span><span>Memahami gambut</span></div><div class="section-heading-row"><h2 id="peat-title">Hutannya terbakar.<br/>Tanahnya juga.</h2><p class="section-deck">Di lahan gambut, api tidak harus berupa nyala tinggi. Ia dapat membara di dalam tanah, jauh dari yang terlihat. <Cite id="page"/></p></div></div>
<div class="peat-scrolly section"><div class="peat-sticky"><div class="peat-stage-buttons" role="group" aria-label="Pilih kondisi ilustrasi gambut">{peatStages.map((s,i)=><button data-peat-button={i} aria-pressed={i===0}>{s.short}</button>)}</div><div id="peat-canvas" class="peat-canvas" data-stage="0" role="img" aria-label="Ilustrasi tiga dimensi penampang gambut basah dengan hutan dan air yang tertahan"><svg class="peat-fallback" viewBox="0 0 700 510" aria-hidden="true"><defs><linearGradient id="soil" x2="0" y2="1"><stop stop-color="#785640"/><stop offset="1" stop-color="#342d24"/></linearGradient></defs><ellipse cx="350" cy="437" rx="267" ry="34" fill="#193b2d" opacity=".1"/><path d="M90 250 350 110 612 250 350 396Z" fill="#556d47"/><path d="M90 250v115l260 135V396Z" fill="#654c38"/><path d="M350 396 612 250v115L350 500Z" fill="url(#soil)"/><path class="fallback-water" d="m90 305 260 137 262-146" fill="none" stroke="#678d92" stroke-width="14" opacity=".8"/><path d="m90 350 260 137 262-146" fill="none" stroke="#a07850" stroke-width="4"/><g class="fallback-trees" fill="#234839" stroke="#234839">{[[230,200],[310,157],[402,192],[465,238],[335,273]].map(([x,y])=><g><path d={`M${x} ${y+30}v-85`} stroke="#554331" stroke-width="7"/><ellipse cx={x} cy={y-60} rx="29" ry="42"/><ellipse cx={x-13} cy={y-46} rx="26" ry="32"/></g>)}</g><g class="peat-fallback-fire"><path d="m280 356 24-12 40 20 35-8 45 24-42 13-37-14-37 6Z" fill="#dc6a30"/><path d="m303 362 42 12 34-7" fill="none" stroke="#ffe0a0" stroke-width="5"/></g><path d="m140 226 215 115 196-107" stroke="#548f97" stroke-width="12" fill="none"/></svg></div><div class="peat-caption"><span class="stage-status"><i></i><span id="peat-state-label">{peatStages[0].label}</span></span><span>Ilustrasi mekanisme · tidak berskala</span></div></div><div class="peat-steps">{peatStages.map((s,i)=><article class="peat-step" data-peat-step={i}><span class="step-number">{String(i+1).padStart(2,'0')}</span><h3>{s.title}</h3><p>{s.text} <Cite id={i===3?'bnf':'page'}/></p></article>)}</div></div>
<div class="causes section"><h3>Api memerlukan penyalaan.<br/>Krisisnya memiliki banyak lapisan.</h3><div class="cause-grid"><div><span class="cause-icon" aria-hidden="true">↳</span><h4>Sumber api</h4><p>Pembakaran untuk membuka atau mengelola lahan dapat lepas kendali. Jangan menyamakan semua warga atau pelaku usaha sebagai penyebab.</p></div><div><span class="cause-icon" aria-hidden="true">≈</span><h4>Bentang yang mengering</h4><p>Drainase mengubah simpanan air. Gambut yang kering lebih rentan terbakar ketika bertemu sumber penyalaan.</p></div><div><span class="cause-icon" aria-hidden="true">☼</span><h4>Musim & tata kelola</h4><p>Kekeringan memperpanjang kondisi rawan. Pencegahan juga menyangkut cara penggunaan dan pengelolaan lahan.</p></div></div><p class="small">Dasar mekanisme dan konteks: <Cite id="page"/> <Cite id="nasa2015"/> <Cite id="nasa2019"/></p></div>
</section>

<section id="peta" class="map-section section" aria-labelledby="data-title"><div class="section-meta"><span>04 / Membaca wilayah</span><span>Cuplikan 22–24 Oktober 2026</span></div><div class="section-heading-row"><h2 id="data-title" data-reveal>Satu pulau.<br/><span class="serif-word">Beda situasi.</span></h2><p class="section-deck">Bandingkan tiga cuplikan resmi. Provinsi yang tidak dirinci tidak diisi dengan nol.</p></div><CurrentMap/><details class="historical-map" data-historical><summary>Konteks data: luas tahunan 2019–2023</summary><p>Unit hektare, cakupan setahun penuh. Tidak dapat dibandingkan langsung dengan jumlah hotspot Oktober 2026.</p><DataMap/></details></section>
<section id="dampak" class="section impact-section" aria-labelledby="impact-title"><div class="section-meta"><span>05 / Di luar garis api</span><span>Dampak saling terhubung</span></div><h2 id="impact-title" data-reveal>Api di satu tempat.<br/><span class="serif-word">Dampak ke banyak arah.</span></h2><div class="impact-atlas impact-reading"><div class="impact-items"><article data-reveal><span>01</span><div><h3>Manusia</h3><p>Asap dapat mengiritasi mata dan saluran napas, serta memperburuk asma. Anak, lansia, ibu hamil dan penderita penyakit jantung/paru lebih rentan. <Cite id="who"/></p></div></article><article data-reveal><span>02</span><div><h3>Habitat</h3><p>Respons Oktober 2026 mencakup penyelamatan satwa dan perlindungan habitat. Dampaknya melampaui area yang tampak menghitam. <Cite id="current23"/></p></div></article><article data-reveal><span>03</span><div><h3>Iklim</h3><p>Ketika gambut terbakar, karbon dari bahan organik terlepas ke atmosfer. <Cite id="page"/></p></div></article></div></div><p class="small muted impact-disclaimer">Visual partikel merupakan ilustrasi konseptual, tidak berskala. Untuk kondisi udara setempat, ikuti informasi dan arahan resmi.</p></section>
<section id="pulih" class="recovery-section" aria-labelledby="recovery-title"><div class="recovery-visual"><img src="/media/sebangau-2021.webp" width="1600" height="1068" alt="Air hitam Sungai Sebangau dan vegetasi riparian, 21 Maret 2021." loading="lazy"/><div class="recovery-image-note">Sebangau · arsip 21 Maret 2021 · Mankdhay rahman · CC BY-SA 4.0<br/>Diperkecil dan dikompresi. Konteks bentang, bukan bukti hasil restorasi.</div><div class="recovery-title"><span>06 / Memberi ruang untuk pulih</span><h2 id="recovery-title" data-reveal>Mulai dari air.<br/><span class="serif-word">Rawat kehidupan.</span></h2></div></div><div class="section recovery-content"><div class="rescue-stat" data-reveal><div class="rescue-number">51<span>orangutan</span></div><div><h3>Diselamatkan dari wilayah terdampak.</h3><p>Ketapang dan Kayong Utara, 6 Agustus–pertengahan Oktober 2026. Ini jumlah penyelamatan yang dilaporkan, bukan kematian atau total satwa terdampak di Kalimantan. <Cite id="current23"/></p></div></div><div class="recovery-path"><article data-reveal><span>01 / Respons</span><h3>Padamkan bara.</h3><p>Pembasahan, penyisiran dan pendinginan berlanjut pada gambut setelah nyala permukaan hilang. <Cite id="current22"/></p></article><article data-reveal><span>02 / Hidrologi</span><h3>Pertahankan air.</h3><p>Penyekatan kanal dan pemantauan hidrologi membantu mengurangi kehilangan air, seperti pada kerja di Sebangau. <Cite id="bnf"/></p></article><article data-reveal><span>03 / Jangka panjang</span><h3>Pulihkan bersama.</h3><p>Vegetasi yang sesuai, perawatan dan keterlibatan warga perlu berjalan bersama pembasahan kembali. <Cite id="bnf"/></p></article></div><a class="text-link" href="https://borneonaturefoundation.org/conservation/hydrological-monitoring-for-protecting-peatlands/" target="_blank" rel="noopener noreferrer">Kenali kerja pemulihan Sebangau <Icon name="external" size={16}/></a></div></section>
<section id="wynn" class="creator-section section" aria-labelledby="creator-title"><div class="section-meta"><span>07 / Di balik pengalaman ini</span><span>Desain & pengembangan independen</span></div><div class="creator-grid"><div class="portrait-column"><div class="creator-image-wrap lightcone" data-portrait tabindex="0" role="img" aria-label="Kartu ilustrasi Wynn"><div class="lightcone-surface"><img src="/media/wynn-profile.webp" alt="" width="863" height="1536" loading="lazy"/><div class="lightcone-foil" aria-hidden="true"></div><div class="lightcone-gloss" aria-hidden="true"></div><div class="lightcone-edge" aria-hidden="true"></div></div></div></div><div class="creator-bio"><p class="creator-role">Pembuat produk digital · Otodidak</p><h2 id="creator-title" data-reveal>Wynn<span>.</span></h2><p class="creator-statement">Belajar dengan<br/><em>mewujudkan ide.</em></p><p>Saya membangun website dan aplikasi Android—dari merancang antarmuka sampai menerbitkan produk yang dapat digunakan. Kemampuan saya tumbuh lewat eksperimen, pengujian, dan revisi.</p><p>Dokumenter ini adalah eksplorasi saya dalam menyatukan riset, desain, dan interaksi web.</p><ul class="creator-capabilities"><li><span>01</span>Desain antarmuka</li><li><span>02</span>Pengembangan web & Android</li><li><span>03</span>Publikasi produk digital</li></ul><div class="creator-links"><a href="https://github.com/WynnDev-rill/Wynn-Store" target="_blank" rel="noopener noreferrer" class="text-link">Jelajahi karya & kode <Icon name="external" size={17}/></a><a href="/sumber/" class="text-link">Sumber dokumenter <Icon name="arrow" size={17}/></a></div></div></div></section>
<section class="closing-section section"><p class="closing-kicker">Kembali ke bentangnya</p><h2 data-reveal>Yang kita jaga,<br/><span class="serif-word">lebih dari hutan.</span></h2><div><p>Air, tanah, dan kehidupan saling terhubung. Memahami karhutla dimulai dengan membaca bukti.</p><a class="button button-dark" href="/sumber/">Sumber & metodologi <Icon name="arrow" size={19}/></a></div><a class="current-link" href="https://www.bmkg.go.id/cuaca/karhutla" target="_blank" rel="noopener noreferrer">Informasi kondisi terkini dari BMKG <Icon name="external" size={15}/></a></section>
</main><button class="cinematic-pause" data-cinematic-pause aria-pressed="false" aria-label="Jeda gerak sinematik"><svg data-pause-icon viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4 3h3v10H4zm5 0h3v10H9z"/></svg><span data-pause-label>Jeda gerak</span></button><button class="sound-toggle" data-sound-toggle aria-pressed="false" aria-label="Aktifkan suara suasana"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Zm4 3c2 2 2 6 0 8m3-11c4 4 4 10 0 14"/></svg><span data-sound-label>Suara mati</span></button>
<script>
import '../scripts/documentary';
import '../scripts/motion';
import '../scripts/portrait';
import '../scripts/ambience';
import '../scripts/cinematic';
import '../scripts/cinematic-controls';
</script>
</SiteLayout>
