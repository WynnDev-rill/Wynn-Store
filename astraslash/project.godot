config_version=5
[application]
config/name="AstraSlash"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/description="AstraSlash — Malam Orbit Pecah"
config/version="1.0.1"
config/icon="res://assets/art/icon.png"
boot_splash/image="res://assets/art/icon.png"
boot_splash/bg_color=Color(0.024,0.043,0.075,1)
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/frame_pacing/android/enable_frame_pacing=false
[input_devices]
pointing/emulate_touch_from_mouse=true
[rendering]
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
renderer/rendering_method.web="gl_compatibility"
[physics]
common/physics_ticks_per_second=60
